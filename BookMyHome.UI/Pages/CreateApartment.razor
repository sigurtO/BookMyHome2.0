@page "/create-apartment"
@inject HttpClient Http
@inject BookMyHome.UI.Services.IImageFileService ImageFileService
@using BookMyHome.Application.Dtos
@using System.Net.Http.Json

<h3>Create Apartment</h3>

<EditForm Model="@apartment" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Host:</label>
        <InputSelect @bind-Value="apartment.UserID" class="form-control">
            <option value="">-- Select Host --</option>
            @foreach (var host in hosts)
            {
                <option value="@host.UserID">@host.UserName</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Address:</label>
        <InputText @bind-Value="apartment.Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description:</label>
        <InputTextArea @bind-Value="apartment.Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Price:</label>
        <InputNumber @bind-Value="apartment.Price" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Available:</label>
        <InputCheckbox @bind-Value="apartment.AvailabiltyStatus" />
    </div>

    <!-- 🖼️ Image Upload -->
    <div class="mb-3">
        <label for="apartmentimage" class="form-label">Apartment Image:</label>
        <div class="custom-file-input">
            <InputFile id="apartmentimage"
                       accept=".jpg,.jpeg,.png"
                       OnChange="HandleImageFile" />
            <span class="custom-file-label">Choose File</span>
        </div>
        @if (imagePreview != null)
        {
            <div style="margin: 1rem; border: solid black 2px; width: 254px; height: 254px;">
                <img src="@imagePreview" alt="Image Preview" style="width: 250px; height: 250px;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@if (successMessage != null)
{
    <div class="alert alert-success mt-3">@successMessage</div>
}
@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">
        <strong>@errorMessage</strong>
        @if (!string.IsNullOrWhiteSpace(errorDetail))
        {
            <div class="mt-2"><small>@errorDetail</small></div>
        }
    </div>
}

@code {
    private ApartmentDto apartment = new();
    private List<UserDto> hosts = new();
    private string? successMessage;
    private string? errorMessage;
    private string? errorDetail;

    // 🖼️ Image preview string //////////////////////////
    private string? imagePreview;

    protected override async Task OnInitializedAsync()
    {
        var allUsers = await Http.GetFromJsonAsync<List<UserDto>>("api/user");
        hosts = allUsers?.Where(u => u.AccountType == "Host").ToList() ?? new();
    }

    private async Task HandleValidSubmit()
    {
        successMessage = null;
        errorMessage = null;
        errorDetail = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/apartment", apartment);
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Apartment created successfully!";
                apartment = new(); // Reset form
                imagePreview = null; // Clear preview ///////////////////
            }
            else
            {
                ApiError? apiError = null;
                try
                {
                    apiError = await response.Content.ReadFromJsonAsync<ApiError?>();
                }
                catch { }

                if (apiError != null)
                {
                    errorMessage = apiError.message ?? apiError.error ?? "Failed to create apartment.";
                    errorDetail = apiError.detail;
                }
                else
                {
                    var raw = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Failed to create apartment (status {response.StatusCode})";
                    errorDetail = string.IsNullOrWhiteSpace(raw) ? null : raw;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error sending request.";
            errorDetail = ex.Message;
        }
    }

    // 🖼️ Handle image upload //////////////////////////
    private async Task HandleImageFile(InputFileChangeEventArgs e)
    {
        if (e.File is null) return;

        var result = await ImageFileService.ProcessAsync(e.File, maxBytes: 150_000);
        if (!result.Success)
        {
            errorMessage = result.Error;
            return;
        }

        imagePreview = result.DataUrl;
        apartment.Image = result.Bytes ?? Array.Empty<byte>();
    }

    private class ApiError
    {
        public string? message { get; set; }
        public string? error { get; set; }
        public string? detail { get; set; }
    }

    public class ApartmentDto
    {
        public Guid ApartmentID { get; set; }
        public Guid UserID { get; set; }
        public string Address { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int Price { get; set; }
        public byte[] Image { get; set; } = Array.Empty<byte>();
        public bool AvailabiltyStatus { get; set; }
    }
}

